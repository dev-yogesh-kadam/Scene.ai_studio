# Copy to deploy/zoro/.env (gitignored: never commit it) and fill in every <...>. How to make each value:
#   passwords:         openssl rand -hex 24        (hex: nothing that needs quoting in a database URL)
#   SCENE_SECRET_KEY:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                      or, without Python's cryptography:  openssl rand 32 | base64 | tr '+/' '-_'
# Keep a copy of SCENE_SECRET_KEY somewhere safe, apart from the backups: the keys saved in the console (Anthropic,
# the providers) are encrypted with it and can't be read without it.

POSTGRES_PASSWORD=<openssl rand -hex 24>
SCENE_OWNER_PASSWORD=<openssl rand -hex 24>
SCENE_APP_PASSWORD=<openssl rand -hex 24>
SCENE_SECRET_KEY=<a Fernet key>

# Folders outside the repo, owned by the app's account in the image (uid 10001): see README.md. Absolute paths.
SCENE_DATA_DIR=/home/<you>/scene/data
SCENE_OUTPUTS_DIR=/home/<you>/scene/outputs
SCENE_BACKUPS_DIR=/home/<you>/scene/backups

# Ports, published on SCENE_BIND / SCENE_CONSOLE_BIND only (127.0.0.1: this machine; or Zoro's Tailscale address).
SCENE_STUDIO_PORT=8080
SCENE_CONSOLE_PORT=8090
SCENE_BIND=127.0.0.1
SCENE_CONSOLE_BIND=127.0.0.1

# Days of database and file backups kept
SCENE_BACKUP_KEEP=14
# true once Caddy serves the studio over https
SCENE_SECURE_COOKIES=false
SCENE_TIME_ZONE=Asia/Kolkata
