# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# HyperFrames and its packages, installed by `npm install` in motion/
motion/node_modules/
# Google Fonts the motion pages name, fetched by HyperFrames once and kept
motion/.fonts/

# The client apps (npm workspaces apps/*, packages/*): packages installed at the root, built output, test reports
node_modules/
apps/web/dist/
apps/web/test-results/
apps/web/playwright-report/
/test-results/
*.tsbuildinfo

# Local settings and data (users, sessions, generated media)
config.json
secret.key
storage/

# Screen recordings and reference footage live outside the repo (C:\Scene\media), never in git
*.mp4
*.mov

# OS and editor
.DS_Store
Thumbs.db

# Internal notes and topology: kept local, never pushed
docs/

# The ComfyUI agent's handover folders as they came, after their files were sorted into workflows/: kept local
workflows/archive/v3_handover_*/
apps/web/tests/look/shots/

# Secrets of this machine (database passwords, keys): read at start (config.py), never committed
scene.env

# Coverage data (pytest-cov), made by scripts/gate.* -Coverage
.coverage
