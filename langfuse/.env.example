# Secrets for Langfuse (read by docker compose in this folder). Copy to .env and fill in every <...>: .env is
# gitignored and never committed. Each value is made once and then kept (changing SALT or ENCRYPTION_KEY later makes
# Langfuse's stored data unreadable).
#   openssl rand -hex 32        for ENCRYPTION_KEY (exactly 64 hex characters)
#   openssl rand -base64 32     for SALT, NEXTAUTH_SECRET
#   openssl rand -hex 24        for the passwords (hex: no character that needs quoting in a URL)
SALT=<openssl rand -base64 32>
ENCRYPTION_KEY=<openssl rand -hex 32>
NEXTAUTH_SECRET=<openssl rand -base64 32>
# Where your browser opens Langfuse. On Zoro through an SSH tunnel (ssh -L 3000:127.0.0.1:3000 ...) this stays as is.
NEXTAUTH_URL=http://localhost:3000
TELEMETRY_ENABLED=false

POSTGRES_PASSWORD=<postgres password>
# The same password as POSTGRES_PASSWORD
DATABASE_URL=postgresql://postgres:<postgres password>@postgres:5432/postgres
CLICKHOUSE_PASSWORD=<clickhouse password>
REDIS_AUTH=<redis password>
MINIO_ROOT_PASSWORD=<minio password>
# The same password as MINIO_ROOT_PASSWORD, three times
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<minio password>
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<minio password>
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=<minio password>

# First start creates this org, project, login and API keys (the studio uses the two keys: enter them, with Langfuse's
# address, in the admin console's Servers & APIs). The keys are any strings with these prefixes, e.g.
#   pk-lf-$(openssl rand -hex 16)   and   sk-lf-$(openssl rand -hex 16)
LANGFUSE_INIT_ORG_ID=scene
LANGFUSE_INIT_ORG_NAME=Scene
LANGFUSE_INIT_PROJECT_ID=scene-ai
LANGFUSE_INIT_PROJECT_NAME=Scene.ai
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-<random>
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-<random>
LANGFUSE_INIT_USER_EMAIL=<your email>
LANGFUSE_INIT_USER_NAME=<your name>
LANGFUSE_INIT_USER_PASSWORD=<a password for the Langfuse login>
