# What never goes into the image: secrets, local data, packages that are installed inside it, build output, tests.
.git
.venv
**/__pycache__
**/*.pyc
.pytest_cache
node_modules
**/node_modules
apps/web/dist
apps/mobile/dist
apps/web/test-results
apps/web/playwright-report
apps/web/tests/look/shots
test-results
config.json
config.example.json
secret.key
storage
docs
content
motion/.fonts
backend/tests
workflows/archive
scene.env
# A pattern without **/ matches only at the top of the context: these are excluded at any depth, so a settings file,
# a key, a database copy or a clip left in a subfolder never reaches an image layer either.
**/config.json
**/secret.key
**/scene.env
**/.env
**/*.env
**/*.pem
**/*.key
**/*.dump
**/backups
**/storage
**/*.mp4
**/*.mov
**/*.zip
.github
.claude
**/.claude
