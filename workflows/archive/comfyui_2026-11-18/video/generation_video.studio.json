{
  "title": "Generation video",
  "description": "Video on the provider's models (Seedance 2.5, Seedance 2.0, Seedance 2.0 Fast, Seedance 2.0 Mini, Kling O3 Standard, Kling 3.0 Standard, Kling 3.0 Turbo, Kling 4, Happy Horse 1.1, Gemini Omni Flash (Preview), Gemini Omni 1.1 Flash, MiniMax H3, Grok Imagine Video 1.5, MiniMax H3 Max, Wan 3.0, Wan 3.0 Prime), made by the generation server. Pick the model in the Model setting.",
  "pick_when": "A video made on one of the provider's models (Seedance, Kling, Wan, MiniMax, Gemini Omni, Grok, …), paid in provider credits. Choose the model in the \"Model\" setting: each choice says what it is good at, its lengths, frames, references and price.",
  "output_name": "10.filename_prefix",
  "labels": {
    "1:value": "Prompt",
    "2:value": "Length in seconds (1 to 30; each model has its own range)",
    "3:image": "First frame: the clip starts on this image",
    "4:image": "Last frame: the clip ends on this image",
    "5:audio": "Reference audio 1: a voice, music or sound the clip follows",
    "6:audio": "Reference audio 2: a voice, music or sound the clip follows",
    "7:audio": "Reference audio 3: a voice, music or sound the clip follows",
    "8:video": "Reference video: a clip to continue or edit"
  },
  "defaults": {
    "1:value": "",
    "2:value": 5
  },
  "options": [
    {
      "id": "model",
      "label": "Model",
      "default": "minimax_h3_max",
      "top": true,
      "choices": [
        {
          "id": "seedance_2_5",
          "label": "Seedance 2.5",
          "hint": "Default for most video: cinematic multi-shot scenes, long takes up to 30s, many references. 4–30 s, first+last frame, up to 9 reference images, sound on/off. 480p 13/13, 720p 28/28, 1080p 72/72 credits per second (silent/with sound)."
        },
        {
          "id": "seedance_2_0",
          "label": "Seedance 2.0",
          "hint": "Strong motion and character consistency in clips up to 15s; the Seedance for 4K. 4–15 s, first+last frame, up to 9 reference images, sound on/off. 480p 9/9, 720p 19/19, 1080p 45/45, 2160p 94/94 credits per second (silent/with sound)."
        },
        {
          "id": "seedance_2_0_fast",
          "label": "Seedance 2.0 Fast",
          "hint": "Quick Seedance drafts for iterating on prompts and shots. 4–15 s, first+last frame, up to 9 reference images, sound on/off. 480p 7/7, 720p 15/15 credits per second (silent/with sound)."
        },
        {
          "id": "seedance_2_0_mini",
          "label": "Seedance 2.0 Mini",
          "hint": "Cheapest Seedance previews to test an idea before the final render. 4–15 s, first+last frame, up to 9 reference images, sound on/off. 480p 5/5, 720p 10/10 credits per second (silent/with sound)."
        },
        {
          "id": "kling_o3_standard",
          "label": "Kling O3 Standard",
          "hint": "Dependable Kling clips, and clip edits that keep the source clip's own sound. 3–15 s, first+last frame, no reference images, silent. 720p 11 credits per second."
        },
        {
          "id": "kling_3_0_standard",
          "label": "Kling 3.0 Standard",
          "hint": "Solid text- or image-to-video when Seedance isn't available and no clip edit is needed. 3–15 s, first+last frame, no reference images, silent. 720p 11 credits per second."
        },
        {
          "id": "kling_3_0_turbo",
          "label": "Kling 3.0 Turbo",
          "hint": "Quick, low-cost Kling clips from text or a first frame, with sound. 3–15 s, first frame, no reference images, sound on/off. 720p 14/14, 1080p 17/17 credits per second (silent/with sound)."
        },
        {
          "id": "kling_4_0",
          "label": "Kling 4",
          "hint": "Kling clips of 3-30s with native sound, from first and last frames, up to 10 reference images, or a reference clip that guides a new video. 3–30 s, first+last frame, up to 9 reference images, always with sound. 720p 19, 1080p 29 credits per second."
        },
        {
          "id": "happy_horse_1_1",
          "label": "Happy Horse 1.1",
          "hint": "Stylized, expressive character animation with several characters. 3–15 s, first frame, up to 9 reference images, always with sound. 720p 15, 1080p 20 credits per second."
        },
        {
          "id": "gemini_omni_flash_preview",
          "label": "Gemini Omni Flash (Preview)",
          "hint": "Plain-language edits of a clip and reference-led shots, with sound. 3–10 s, first+last frame, up to 9 reference images, always with sound. 720p 12 credits per second."
        },
        {
          "id": "gemini_omni_1_1_flash",
          "label": "Gemini Omni 1.1 Flash",
          "hint": "Plain-language edits of a clip (relight, restyle, add things), up to 4K. 3–10 s, first+last frame, up to 9 reference images, always with sound. 720p 12, 1080p 18, 2160p 36 credits per second."
        },
        {
          "id": "minimax_h3",
          "label": "MiniMax H3",
          "hint": "Clips with native stereo sound, guided by image, clip or audio references. 5–15 s, first+last frame, up to 9 reference images, always with sound. 768p 10, 2k 15 credits per second."
        },
        {
          "id": "grok_imagine_video_1_5",
          "label": "Grok Imagine Video 1.5",
          "hint": "xAI video from text or a first frame, with optional sound, including 3:2 and 2:3. 1–15 s, first frame, no reference images, sound on/off. 480p 10/10, 720p 17/17, 1080p 30/30 credits per second (silent/with sound)."
        },
        {
          "id": "minimax_h3_max",
          "label": "MiniMax H3 Max",
          "hint": "Cheaper, faster MiniMax clips with native sound, from frames or image and audio references. 5–15 s, first+last frame, up to 9 reference images, always with sound. 480p 6, 768p 10, 1080p 20 credits per second."
        },
        {
          "id": "wan_3_0",
          "label": "Wan 3.0",
          "hint": "Clips up to 30s that can edit or extend a source clip, with up to 10 image and 5 audio references. 2–30 s, first+last frame, up to 9 reference images, sound on/off. 480p 7/7, 720p 14/14, 1080p 28/28 credits per second (silent/with sound)."
        },
        {
          "id": "wan_3_0_prime",
          "label": "Wan 3.0 Prime",
          "hint": "Higher-quality, pricier Wan 3.0 with the same inputs. 2–30 s, first+last frame, up to 9 reference images, sound on/off. 480p 10/10, 720p 20/20, 1080p 40/40 credits per second (silent/with sound)."
        }
      ]
    },
