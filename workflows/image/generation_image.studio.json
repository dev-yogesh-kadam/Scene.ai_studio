{
  "title": "Generation image",
  "description": "Image on the provider's models (Nano Banana Pro, GPT Image 2, GPT Image 2.5 Sunburst, Seedream 5.0 Pro, GPT Image 2.5 Flare, Nano Banana 2.1, Nano Banana 2, Grok Imagine Image 2.0, Seedream 5 Lite, Seedream 5.0 Flash, Nano Banana 2 Lite), made by the generation server. Pick the model in the Model setting.",
  "pick_when": "An image made on one of the provider's models (Nano Banana, GPT Image, Seedream, Grok, …), paid in provider credits; for edits from source images too. Choose the model in the \"Model\" setting.",
  "output_name": "10.filename_prefix",
  "labels": {
    "1:value": "Prompt"
  },
  "defaults": {
    "1:value": ""
  },
  "options": [
    {
      "id": "model",
      "label": "Model",
      "default": "nano_banana_pro",
      "top": true,
      "choices": [
        {
          "id": "nano_banana_pro",
          "label": "Nano Banana Pro",
          "hint": "Default for scenes, edits and compositing; keeps faces and products the same; legible text. Up to 14 source images. 2K 18, 4K 36 credits per image."
        },
        {
          "id": "openai_gpt_image_2",
          "label": "GPT Image 2",
          "hint": "Characters, portraits and character sheets where identity must hold. Up to 14 source images. 2K 6, 4K 13 credits per image."
        },
        {
          "id": "openai_gpt_image_2_5_sunburst",
          "label": "GPT Image 2.5 Sunburst",
          "hint": "Fine-detail images and precise, controlled edits. Up to 14 source images. 1K 2, 2K 2, 4K 4 credits per image."
        },
        {
          "id": "seedream_5_0_pro",
          "label": "Seedream 5.0 Pro",
          "hint": "Top-fidelity Seedream from up to 10 references, at 1K or 2K. Up to 10 source images. 1K 11, 2K 11 credits per image."
        },
        {
          "id": "openai_gpt_image_2_5_flare",
          "label": "GPT Image 2.5 Flare",
          "hint": "Fast everyday images and edits, including wide banners. Up to 14 source images. 1K 2, 2K 2, 4K 4 credits per image."
        },
        {
          "id": "nano_banana_2_1",
          "label": "Nano Banana 2.1",
          "hint": "Everyday images and edits with many references. Up to 14 source images. 1K 15, 2K 15, 4K 20 credits per image."
        },
        {
          "id": "nano_banana_2",
          "label": "Nano Banana 2",
          "hint": "Balanced quality and speed for everyday images and edits. Up to 14 source images. 2K 15, 4K 20 credits per image."
        },
        {
          "id": "grok_imagine_image_2_0",
          "label": "Grok Imagine Image 2.0",
          "hint": "xAI images and edits at 1K or 2K, from up to 3 input images. Up to 3 source images. 1K 8, 2K 10 credits per image."
        },
        {
          "id": "seedream_5_lite",
          "label": "Seedream 5 Lite",
          "hint": "Quick Seedream drafts and iterations. Up to 14 source images. 2K 5, 4K 5 credits per image."
        },
        {
          "id": "seedream_5_0_flash",
          "label": "Seedream 5.0 Flash",
          "hint": "High-volume, low-cost drafts and quick edits. Up to 10 source images. 1K 4, 2K 4 credits per image."
        },
        {
          "id": "nano_banana_2_lite",
          "label": "Nano Banana 2 Lite",
          "hint": "Fast, cheap 1K drafts for exploring concepts. Up to 14 source images. 1K 6 credits per image."
